<?PHP
/* DriveAge Plugin - Dashboard */
require_once '/usr/local/emhttp/plugins/driveage/include/version.php';
require_once '/usr/local/emhttp/plugins/driveage/include/config.php';
require_once '/usr/local/emhttp/plugins/driveage/include/risk.php';
require_once '/usr/local/emhttp/plugins/driveage/include/helpers.php';

$config = loadConfig();

// Helper function to format years without .0 for whole numbers
function formatYears($hours) {
    $years = $hours / 8760;
    if (floor($years) == $years) {
        return number_format($years, 0);
    }
    return number_format($years, 1);
}

// Cache busting tied to the plugin version (single source: version.php)
$cacheVersion = DRIVEAGE_VERSION;
?>
<link rel="stylesheet" href="/plugins/driveage/styles/driveage.css?v=<?= e($cacheVersion); ?>">

<script src="/plugins/driveage/js/dashboard.js?v=<?= e($cacheVersion); ?>"></script>
<script src="/plugins/driveage/js/vendor/chart.min.js?v=<?= e($cacheVersion); ?>"></script>
<script src="/plugins/driveage/js/charts.js?v=<?= e($cacheVersion); ?>"></script>

<div class="driveage-container">
    <div class="driveage-header">
        <div>
            <span id="last-updated" class="last-updated">Loading...</span>
